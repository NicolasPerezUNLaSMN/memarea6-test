# Ingreso con cuenta Microsoft y/o Google. Copiar como .streamlit/secrets.toml
# (NO se sube a git ni entra en la imagen Docker) y completar.
# Sin este archivo la app no pide ingreso: el nombre se escribe a mano.

[auth]
# Dirección pública de la app + /oauth2callback. Debe coincidir EXACTO con la
# registrada en Microsoft Entra y/o Google Cloud.
redirect_uri = "http://localhost:8501/oauth2callback"
# Texto al azar y largo, p. ej.: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CAMBIAR"

# Microsoft (Entra ID): registro de aplicación «web» en el tenant del SMN.
# Con el tenant del SMN (no «common») solo entran cuentas institucionales.
[auth.microsoft]
client_id = "CAMBIAR"
client_secret = "CAMBIAR"
server_metadata_url = "https://login.microsoftonline.com/ID_DEL_TENANT/v2.0/.well-known/openid-configuration"

# Google (opcional; borrar esta sección si no se usa). Cliente OAuth «aplicación web».
[auth.google]
client_id = "CAMBIAR.apps.googleusercontent.com"
client_secret = "CAMBIAR"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Quién puede entrar. Con Google es imprescindible: si no, entra cualquier cuenta.
[acceso]
dominios = ["smn.gob.ar"]
correos = []          # cuentas sueltas de otros dominios, si hiciera falta
