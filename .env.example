# Copiar como .env y completar.

# Cómo se interpreta el texto claro:
#   reglas = sin IA, gratis, todo local (por defecto)
#   ia     = con Claude (requiere ANTHROPIC_API_KEY)
INTERPRETE=reglas

# Solo si INTERPRETE=ia (o para traducir textos libres con IA).
ANTHROPIC_API_KEY=

# Modelo a usar (verificar el nombre vigente en https://docs.claude.com)
CLAUDE_MODEL=claude-sonnet-5-5

# Codificación de los .txt: utf-8, latin-1 o cp1252 según lo que acepte el sistema de difusión
TXT_ENCODING=utf-8

# Fin de línea de los .txt: lf o crlf (estilo Windows)
TXT_NEWLINE=lf
